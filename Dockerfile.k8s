# =============================================================
# Teedy 多阶段构建 Dockerfile（实验九：Kubernetes 部署精简版）
# 与实验八 Dockerfile 的区别：
#   1. 换用阿里云 apt 镜像源（本地 WSL2+代理环境下，ubuntu 官方源 apt 会 502）
#   2. 精简运行依赖：去掉 OCR 语言包 + ffmpeg/mediainfo（可选功能），
#      只保留核心文档管理所需的最小依赖，镜像更小、构建更快
# =============================================================

# ---------- 阶段 1：构建 ----------
FROM maven:3.9-eclipse-temurin-11 AS builder

# 安装 Node.js 22（与本地已验证的构建环境一致：node v22 + npm 10）
# 注意：使用阿里云 apt 源 + nodesource 仓库，显式安装 nodejs 并校验版本
RUN apt-get update \
    && apt-get install -y curl gnupg ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && node --version \
    && npm --version \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 先拷贝 pom 依赖定义，利用 Docker 层缓存
COPY pom.xml .
COPY docs-core/pom.xml docs-core/
COPY docs-web-common/pom.xml docs-web-common/
COPY docs-web/pom.xml docs-web/

# 预下载 Maven 依赖（缓存层）
RUN mvn -B -ntp dependency:go-offline -DskipTests || true

# 拷贝全部源码
COPY docs-core docs-core/
COPY docs-web-common docs-web-common/
COPY docs-web docs-web/

# 前端构建（npm install + grunt 生成 dist）
WORKDIR /build/docs-web/src/main/webapp
RUN npm install \
    && ./node_modules/.bin/grunt

# Maven 打包（跳过测试，产出 WAR）
WORKDIR /build
RUN mvn -B -ntp package -DskipTests

# ---------- 阶段 2：运行 ----------
# 用 JDK（非 JRE）：Jetty 11 的 start.jar --add-modules 需要 JDK 初始化模块
FROM eclipse-temurin:11-jdk

LABEL maintainer="tangx2872-svg"
LABEL description="Teedy document management system (experiment 9, k8s slim)"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    JAVA_OPTIONS="-Dfile.encoding=UTF-8 -Xmx1g" \
    JETTY_VERSION=11.0.20 \
    JETTY_HOME=/opt/jetty

# 换阿里云 apt 源（本地代理环境下 ubuntu 官方源会 502），并安装最小运行依赖
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list \
    && sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list \
    && apt-get update \
    && apt-get -y -q --no-install-recommends install \
    tzdata curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安装 Jetty 11（home 目录 /opt/jetty）
RUN curl -fsSL -o /tmp/jetty.tar.gz \
    "https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-home/${JETTY_VERSION}/jetty-home-${JETTY_VERSION}.tar.gz" \
    && tar xzf /tmp/jetty.tar.gz -C /opt \
    && mv /opt/jetty-home-${JETTY_VERSION} /opt/jetty \
    && rm /tmp/jetty.tar.gz \
    && useradd jetty -U -s /bin/false \
    && chown -R jetty:jetty /opt/jetty

# Jetty 工作目录（jetty.base = /app），存放 start.ini 与 webapps
RUN mkdir -p /app/webapps /data \
    && chown -R jetty:jetty /app /data

# 拷贝 Jetty 部署配置与 WAR 制品
COPY docs.xml /app/webapps/docs.xml
COPY --from=builder /build/docs-web/target/docs-web-*.war /app/webapps/docs.war

# Jetty 容器内监听端口
EXPOSE 8080

WORKDIR /app

# 以 root 初始化 Jetty 模块（生成 start.ini）
RUN java -jar /opt/jetty/start.jar --add-modules=server,http,webapp,deploy \
    && chown -R jetty:jetty /app

USER jetty

CMD ["java", "-jar", "/opt/jetty/start.jar"]
